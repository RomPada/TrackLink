SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Must be a server Secret key (sb_secret_...), not sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SECRET=replace-with-a-long-random-secret

# Generate with: npm run vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Real contact mailto: address or https: URL. Not localhost.
VAPID_SUBJECT=mailto:you@example.com

# Separate random secret (16+ chars) used to protect the daily summary cron
CRON_SECRET=
